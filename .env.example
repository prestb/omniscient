APP_NAME=Omniscient
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Africa/Douala
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omniscient
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================
# Mail
# =============================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Omniscient Platform"

# Contact email (where contact form submissions are routed)
CONTACT_EMAIL=

# =============================================================
# Filesystem (AWS optional — leave blank for local storage)
# =============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================
# Search (Meilisearch)
# =============================================================
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# =============================================================
# Vite
# =============================================================
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL=http://localhost:8000

# =============================================================
# Development tunnel (ngrok)
# =============================================================
NGROK_URL=

# =============================================================
# Web Push (VAPID)
# Generate a key pair with: php artisan webpush:vapid
# =============================================================
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# =============================================================
# Subscriptions
# =============================================================
SUBSCRIPTION_EXPIRING_SOON_THRESHOLD=30
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
SUBSCRIPTION_CHECK_FREQUENCY=60

# =============================================================
# Fapshi (payments)
# =============================================================
FAPSHI_ENV=sandbox
FAPSHI_SANDBOX_URL=https://sandbox.fapshi.com
FAPSHI_LIVE_URL=https://live.fapshi.com
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=

# =============================================================
# Sentry (error monitoring)
# DSN is for sending errors
# API token is for reading errors back (scope: event:read, project:read)
# Create at: https://sentry.io/settings/account/api/auth-tokens/
# =============================================================
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_API_TOKEN=



FAILED_JOBS_THRESHOLD=10
FAILED_JOBS_WINDOW_MINUTES=15
FAILED_JOBS_COOLDOWN_MINUTES=30
FAILED_JOBS_ALERT_EMAIL=admin@example.com