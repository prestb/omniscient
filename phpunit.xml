<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    colors="true"
    cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" />
        <env name="APP_MAINTENANCE_DRIVER" value="file" />
        <env name="BCRYPT_ROUNDS" value="4" />
        <env name="CACHE_STORE" value="array" />
        <env name="MAIL_MAILER" value="array" />

        <!--
            PHASE 22D — TEST DATABASE ISOLATION.

            `RefreshDatabase` runs `migrate:fresh`, which DROPS EVERY TABLE in the
            connected database. Without these overrides a local test run loaded
            `.env` and pointed that destructive migration at the DEVELOPMENT
            database `omniscient`.

            Only the CONNECTION and DATABASE NAME are pinned. Host, username and
            password are deliberately left to the environment so CI keeps using
            the `ci_user` account from `.env.ci`; pinning them here would override
            that and break the CI pipeline.

            `tests/TestCase.php` additionally fails closed if this value is ever
            missing or does not end in `_testing`.
        -->
        <env name="DB_CONNECTION" value="mysql" />
        <env name="DB_DATABASE" value="omniscient_testing" />

        <!--
            PHASE 23C-R4 — MEILISEARCH TEST-INDEX ISOLATION.

            Before this, `scout.prefix` was empty, so the suite and the
            development application shared the SAME `listings` index and tests
            wrote real documents into it. `Listing::searchableAs()` also
            returned a bare `'listings'` literal, which silently DISCARDED this
            prefix — so setting it alone changed nothing for Listing.

            Both are now fixed: the index name is resolved through
            `App\Support\SearchIndexName`, which reads this value, and the
            settings that an isolated index needs are written by
            `tests/bootstrap.php` before any test runs.

            `force="true"` is deliberate. Without it PHPUnit leaves an
            already-present environment variable alone, so an ambient
            `SCOUT_PREFIX` (or an unset one inherited from `.env`) could
            silently collapse the suite back onto the development index.
            Isolation must not depend on the operator's shell.
        -->
        <env name="SCOUT_PREFIX" value="test_" force="true" />
    </php>
</phpunit>