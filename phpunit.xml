<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="true"
    cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" />
        <env name="APP_MAINTENANCE_DRIVER" value="file" />
        <env name="BCRYPT_ROUNDS" value="4" />
        <env name="CACHE_STORE" value="array" />
        <env name="DB_CONNECTION" value="mysql" />
        <env name="DB_DATABASE" value="omniscient_testing" />
        <env name="MAIL_MAILER" value="array" />
        <env name="MAIL_FROM_ADDRESS" value="test@example.com" />
        <env name="PULSE_ENABLED" value="false" />
        <env name="QUEUE_CONNECTION" value="sync" />
        <env name="SCOUT_DRIVER" value="null" />
        <env name="SESSION_DRIVER" value="array" />
        <env name="TELESCOPE_ENABLED" value="false" />
        <!-- ✅ Required by spatie/laravel-backup at boot -->
        <env name="BACKUP_NOTIFICATION_EMAIL" value="backup-test@example.com" />
        <env name="BACKUP_ARCHIVE_PASSWORD" value="test-password" />
        <!-- ✅ Required by IpLocationService / ExploreService -->
        <env name="MEILISEARCH_HOST" value="" />
        <env name="AWS_ACCESS_KEY_ID" value="test" />
        <env name="AWS_SECRET_ACCESS_KEY" value="test" />
        <env name="AWS_DEFAULT_REGION" value="eu-north-1" />
        <env name="AWS_BUCKET" value="test-bucket" />
        <env name="AWS_BACKUP_BUCKET" value="test-backup-bucket" />
    </php>
</phpunit>