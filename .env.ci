APP_NAME=Omniscient
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omniscient_testing
DB_USERNAME=ci_user
DB_PASSWORD=ci_password

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

MAIL_MAILER=array
MAIL_FROM_ADDRESS=test@example.com
MAIL_FROM_NAME="${APP_NAME}"

BACKUP_NOTIFICATION_EMAIL=backup-test@example.com
BACKUP_ARCHIVE_PASSWORD=test-password

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
# PHASE 23C-R5 — NOT a secret. The workflow passes `secrets.MEILI_MASTER_KEY`
# (falling back to this same literal) to the Meilisearch service AND to the test
# process as an environment variable, and Dotenv does not overwrite a variable
# that is already present — so in CI this line is superseded and the service and
# the application can never disagree. Setting the repository secret is all that
# is needed to use a real key.
MEILISEARCH_KEY=ci-meilisearch-master-key

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=test-bucket
AWS_BACKUP_BUCKET=test-backup-bucket